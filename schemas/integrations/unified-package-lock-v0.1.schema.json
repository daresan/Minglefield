{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minglefield unified game package lock target v0.1 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lock_version",
    "project_id",
    "packages"
  ],
  "properties": {
    "lock_version": {
      "const": "0.1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "kind",
        "version",
        "publisher",
        "release_source",
        "artifact"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.][a-z][a-z0-9_-]*)+$",
          "maxLength": 128
        },
        "kind": {
          "const": "game_integration"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "release_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "repository"
          ],
          "properties": {
            "provider": {
              "const": "github"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "sha256"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
