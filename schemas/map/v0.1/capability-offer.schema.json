{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daresan/Minglefield/blob/main/schemas/map/v0.1/capability-offer.schema.json",
  "title": "MAP v0.1 draft capability offer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_versions",
    "interaction_profiles",
    "codecs",
    "capabilities"
  ],
  "properties": {
    "map_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+$"
      }
    },
    "interaction_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "turn_based",
          "real_time",
          "hybrid",
          "event_driven"
        ]
      }
    },
    "codecs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"
      }
    }
  }
}
