{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "integration_id",
    "release_source",
    "from_version",
    "to_version",
    "requirements"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1"
    },
    "integration_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.][a-z][a-z0-9_-]*)+$",
      "maxLength": 128
    },
    "release_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "repository": {
          "type": "string",
          "pattern": "^(?![.]{1,2}/)(?![^/]+/[.]{1,2}$)[A-Za-z0-9_][A-Za-z0-9_.-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*$"
        }
      }
    },
    "from_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "to_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "constraint"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "constraint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  },
  "title": "Game integration compatibility assessment declaration v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
