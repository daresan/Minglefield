{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daresan/Minglefield/blob/main/schemas/map/v0.1/game-manifest.schema.json",
  "title": "MAP v0.1 draft game manifest",
  "description": "Discovery metadata, not an authorization credential or guarantee of service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "game_id",
    "name",
    "map_versions",
    "interaction_profiles",
    "codecs",
    "capabilities",
    "endpoints"
  ],
  "properties": {
    "manifest_version": {
      "const": "0.1"
    },
    "game_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "map_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+$"
      }
    },
    "interaction_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "turn_based",
          "real_time",
          "hybrid",
          "event_driven"
        ]
      }
    },
    "codecs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "contains": {
        "const": "json"
      },
      "description": "JSON required for draft reference interoperability; alternate codec profile requires separate validation."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transport",
          "uri"
        ],
        "properties": {
          "transport": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "security_profile": {
            "type": "string"
          }
        }
      }
    },
    "publisher": {
      "type": "string",
      "maxLength": 200
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 128
    }
  }
}
